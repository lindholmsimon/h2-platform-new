# Kopiera till .env.local för lokal utveckling. Lägg ALDRIG in riktiga nycklar i git.

# --- Läge --------------------------------------------------------------------
# Demoläget (fiktiva data, ingen inloggning). Lokalt med `npm run dev` är det
# på som standard; sätt false för att testa säkert läge lokalt.
# I Vercel: sätt true ENDAST för Preview-miljön (gärna med Vercel Deployment
# Protection påslaget).
H2_DEMO_MODE=true

# Krävs utöver H2_DEMO_MODE för att visa demot i Vercels Production-miljö.
# Använd bara medan produktionsmiljön inte är kopplad till riktig data.
# H2_ALLOW_DEMO_IN_PRODUCTION=true

# --- Supabase (används inte i demoläget) --------------------------------------
# Project Settings → API. URL och PUBLISHABLE-nyckel (eller legacy anon) är
# avsedda att vara publika och skyddas av RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# service_role / secret-nyckeln används INTE av applikationen.
# Lägg den inte i Vercel och aldrig med prefixet NEXT_PUBLIC_ (bygget stoppas).
